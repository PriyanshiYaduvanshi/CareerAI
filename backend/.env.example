# ============================================
# .env.example - Copy this to .env and fill in your values
# ============================================

# Server
PORT=5000
NODE_ENV=development

# Logging verbosity: error | warn | info (default) | debug
LOG_LEVEL=info

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-job-platform?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (optional fallback)
GROQ_API_KEY=your_groq_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ============================================
# Email (Business → Candidate emails: Shortlisted, Interview
# Invitation, Rejected, Custom). If SMTP_HOST/SMTP_USER/SMTP_PASS are
# left blank, the app automatically falls back to a "dry run" mode that
# logs the rendered email to the console and records it in Email History
# without actually sending — so the feature works out of the box with
# zero configuration. Fill these in with real SMTP credentials (Gmail,
# SendGrid, Mailgun, Outlook, etc.) to send real emails.
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_or_app_password_here
# "From" header shown to candidates, e.g. "CareerAI <notifications@yourcompany.com>"
SMTP_FROM=CareerAI Hiring <no-reply@careerai.com>

# ============================================
# Market Trend Agent — live external data (Prompt 8)
#
# GitHub (trending languages / popular frameworks) and Remotive (most-
# demanded skills / hiring trends) work OUT OF THE BOX with zero config —
# GitHub's search API is used unauthenticated (60 req/hr, plenty given
# responses are cached — see services/cacheService.js) and Remotive's API
# needs no key at all. Adzuna is optional and only activates (for average-
# salary data) once both variables below are set; leave them blank to run
# on GitHub + Remotive alone.
# ============================================
# Optional. Raises the GitHub Search API rate limit from 60 to 5,000
# requests/hour. A "public repo, read-only" personal access token is
# sufficient — https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. Free at https://developer.adzuna.com/ — enables Adzuna as a
# second job-board source (adds avgSalary to hiring trends). Both must be
# set together; either one blank means Adzuna is skipped entirely.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ============================================
# RAG / Vector Search (Retrieval-Augmented Generation layer)
#
# Embeddings are generated with Google's text-embedding-004 model using
# the SAME GEMINI_API_KEY configured above — no separate credential is
# needed. Vector similarity search runs via MongoDB Atlas Vector Search
# against five dedicated collections (resume_chunks, job_chunks,
# learning_chunks, interview_chunks, market_chunks), created by running:
#
#   node scripts/setupVectorIndexes.js
#
# once per environment, after MONGO_URI (above) points at an Atlas
# cluster with Atlas Search enabled (M10+, Dedicated/Serverless, or Flex).
# ============================================
# Name of the Atlas Search vector index created on each chunk collection.
VECTOR_SEARCH_INDEX_NAME=vector_index
